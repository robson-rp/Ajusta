  group:
    '<path d="M12 4.5 3.5 9 12 13.5 20.5 9 12 4.5Z"/><path d="m3.5 13 8.5 4.5 8.5-4.5"/>',
  photo:
    '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M8 5.5 9.5 3.5h5L16 5.5"/>',
