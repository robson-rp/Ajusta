---
import Logo from './Logo.astro'
import Button from './Button.astro'
import { site, cta } from '../site.config'

const nav = [
  { label: 'Produto', href: '#produto' },
  { label: 'Como funciona', href: '#como-funciona' },
  { label: 'Para quem', href: '#para-quem' },
  { label: 'Preços', href: '#precos' },
  { label: 'Sobre', href: '#sobre' },
]
---
<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <a href="/" class="text-ink" aria-label="AJUSTA — início">
      <Logo class="h-7 w-auto" />
    </a>

    <nav class="hidden items-center gap-8 text-[15px] text-muted lg:flex" aria-label="Principal">
      {nav.map((item) => <a href={item.href} class="hover:text-ink">{item.label}</a>)}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <Button href={site.appUrl} variant="ghost">Iniciar sessão</Button>
      <Button href={cta.start}>Começar agora</Button>
    </div>

    <details class="group relative lg:hidden">
      <summary class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg text-ink hover:bg-canvas" aria-label="Menu">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </summary>
      <div class="absolute right-0 mt-2 w-64 rounded-xl border border-line bg-white p-3 shadow-lg">
        {nav.map((item) => (
          <a href={item.href} class="block rounded-lg px-3 py-2 text-[15px] hover:bg-canvas">{item.label}</a>
        ))}
        <div class="mt-2 grid gap-2 border-t border-line pt-3">
          <Button href={site.appUrl} variant="secondary">Iniciar sessão</Button>
          <Button href={cta.start}>Começar agora</Button>
        </div>
      </div>
    </details>
  </div>
</header>
